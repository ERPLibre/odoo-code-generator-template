<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="demo_website_leaflet_map_view_form" model="ir.ui.view">
        <field name="name">demo_website_leaflet_map_form</field>
        <field name="model">demo.website_leaflet.map</field>
        <field name="arch" type="xml">
            <form string="Titre">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        
            <field name="active" invisible="1" />
            <widget
                name="web_ribbon"
                title="Archived"
                bg_color="bg-danger"
                attrs="{'invisible': [('active', '=', True)]}"
            />
            
                    </div>
                    <group>
                        <field name="category_id" />
                    </group>
                    <group>
                        <field name="company_id" />
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                    <group>
                        <field name="feature_id" />
                    </group>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="demo_website_leaflet_map_view_tree" model="ir.ui.view">
        <field name="name">demo_website_leaflet_map_tree</field>
        <field name="model">demo.website_leaflet.map</field>
        <field name="arch" type="xml">
            <tree>
                <field name="category_id" />
                <field name="company_id" />
                <field name="description" />
                <field name="feature_id" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="demo_website_leaflet_map_demo_website_leaflet_map_action_window" model="ir.actions.act_window">
        <field name="name">Demo website leaflet map</field>
        <field name="res_model">demo.website_leaflet.map</field>
    </record>
</odoo>
